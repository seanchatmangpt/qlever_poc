# QLever Doxygen Configuration
# This file controls the generation of API documentation from source code comments.
# Generated documentation is published to GitHub Pages and linked from docs/.

PROJECT_NAME           = "QLever"
PROJECT_NUMBER         = "0.3.0"
PROJECT_BRIEF          = "High-performance RDF/SPARQL Graph Database"

INPUT                  = src/
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h *.cpp
RECURSIVE              = YES

# Exclude directories
EXCLUDE_PATTERNS       = */test/* */benchmark/* */generated/* */third_party/*
EXCLUDE_SYMBOLS        = *::_* *::~*

# Documentation generation
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANONYMOUS_NSPACES = NO

HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
HIDE_FRIEND_COMPOUNDS  = NO
HIDE_IN_BODY_DOCS      = NO

# Class relationships
SHOW_INCLUDE_FILES     = YES
SHOW_GROUPED_MEMBERS_INC = NO
FORCE_LOCAL_INCLUDES   = YES

# Documentation relationships
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES

# Inheritance diagrams
CLASS_DIAGRAMS         = YES
HAVE_DOT               = NO  # Set to YES if graphviz installed
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES

# Output options
OUTPUT_DIRECTORY       = docs/api
CREATE_SUBDIRS         = NO

# HTML output
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_HEADER            =
HTML_FOOTER            =
HTML_STYLESHEET        =
HTML_EXTRA_STYLESHEET  =
HTML_COLORSTYLE        = AUTO
HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80
HTML_DYNAMIC_SECTIONS  = YES
HTML_INDEX_NUM_ENTRIES = 100

# LaTeX output
GENERATE_LATEX         = NO
LATEX_OUTPUT           = latex
LATEX_CMD_NAME         = latex
MAKEINDEX_CMD_NAME     = makeindex

# RTF output
GENERATE_RTF           = NO

# Man page output
GENERATE_MAN           = NO

# XML output
GENERATE_XML           = NO

# Docbook output
GENERATE_DOCBOOK       = NO

# Docset output
GENERATE_DOCSET        = NO

# Auto-linking
AUTOLINK_SUPPORT       = YES

# Language
OPTIMIZE_OUTPUT_FOR_C  = NO
OPTIMIZE_OUTPUT_JAVA   = NO
OPTIMIZE_FOR_FORTRAN   = NO
OPTIMIZE_OUTPUT_VHDL   = NO
EXTENSION_MAPPING      =

# Markdown
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 0

# Preprocessing
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
EXPAND_ONLY_PREDEF     = NO
SKIP_FUNCTION_MACROS   = YES

# Symbol resolution
RESOLVE_UNDEFINED_REFERENCES = NO
MSCGEN_PATH            =
DIA_PATH               =

# Alphabetical index
ALPHABETICAL_INDEX     = YES
COLS_IN_ALPHA_INDEX    = 5

# Searching
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
EXTERNAL_SEARCH        = NO

# Warnings
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_LACKED     = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO

# Source code
SOURCE_BROWSER         = YES
SOURCE_TOOLTIPS        = YES
USE_HTAGS              = NO
VERBATIM_HEADERS       = YES
CLANG_ASSISTED_PARSING = NO

# Comments
COMMENT_CODE_IS_CODE   = NO
STRIP_CODE_COMMENTS    = NO

# Aliases for custom commands
ALIASES                =

# Miscellaneous
CITE_BIB_FILES         =
LAYOUT_FILE            =
