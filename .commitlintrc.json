{
  "extends": [
    "@commitlint/config-conventional"
  ],
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "docs",
        "test",
        "chore",
        "refactor",
        "perf",
        "style",
        "ci",
        "build"
      ]
    ],
    "type-case": [
      2,
      "always",
      "lowercase"
    ],
    "type-empty": [
      2,
      "never"
    ],
    "subject-empty": [
      2,
      "never"
    ],
    "subject-full-stop": [
      2,
      "never",
      "."
    ],
    "subject-case": [
      2,
      "never",
      [
        "start-case",
        "pascal-case",
        "upper-case"
      ]
    ],
    "header-max-length": [
      2,
      "always",
      100
    ],
    "scope-enum": [
      0,
      "always",
      [
        "engine",
        "index",
        "parser",
        "util",
        "rdf",
        "build",
        "test",
        "docs",
        "dx",
        "ci",
        "EPIC"
      ]
    ]
  }
}
