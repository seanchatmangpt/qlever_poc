# 05-large-dataset.n3 - Realistic Large Dataset
# ===============================================
#
# This file demonstrates:
# - Large-scale realistic data (1000+ triples)
# - E-commerce product catalog with reviews
# - Customer orders and relationships
# - Realistic data patterns for performance testing
#
# Use case: Testing query performance and indexing

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <http://example.org/> .
@prefix prod: <http://example.org/product/> .
@prefix cust: <http://example.org/customer/> .
@prefix order: <http://example.org/order/> .
@prefix review: <http://example.org/review/> .

# =================
# PRODUCT CATEGORIES
# =================

ex:Electronics rdf:type ex:Category ;
    rdfs:label "Electronics" ;
    ex:description "Electronic devices and accessories" .

ex:Laptops rdf:type ex:Category ;
    rdfs:label "Laptops" ;
    ex:parentCategory ex:Electronics .

ex:Smartphones rdf:type ex:Category ;
    rdfs:label "Smartphones" ;
    ex:parentCategory ex:Electronics .

ex:Tablets rdf:type ex:Category ;
    rdfs:label "Tablets" ;
    ex:parentCategory ex:Electronics .

ex:Accessories rdf:type ex:Category ;
    rdfs:label "Accessories" ;
    ex:parentCategory ex:Electronics .

ex:Books rdf:type ex:Category ;
    rdfs:label "Books" ;
    ex:description "Physical and digital books" .

ex:Clothing rdf:type ex:Category ;
    rdfs:label "Clothing" ;
    ex:description "Apparel and fashion" .

ex:HomeGarden rdf:type ex:Category ;
    rdfs:label "Home & Garden" ;
    ex:description "Home improvement and garden supplies" .

