# knowledge-graph.n3 - Knowledge Graph Sample
# ============================================
#
# This file demonstrates:
# - Building a domain-specific knowledge graph
# - Complex relationships and reasoning
# - Use case: Academic knowledge graph (universities, researchers, papers, conferences)
# - OWL properties for inference
#
# Knowledge graphs combine structured data with semantic relationships
# to enable complex queries and knowledge discovery

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <http://example.org/academic/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

# ==================
# ONTOLOGY DEFINITIONS
# ==================

# Classes
ex:University rdf:type owl:Class ;
    rdfs:label "University" ;
    rdfs:comment "An institution of higher education" .

ex:Department rdf:type owl:Class ;
    rdfs:label "Department" ;
    rdfs:comment "An academic department within a university" .

ex:Researcher rdf:type owl:Class ;
    rdfs:subClassOf foaf:Person ;
    rdfs:label "Researcher" ;
    rdfs:comment "A person engaged in academic research" .

ex:ResearchPaper rdf:type owl:Class ;
    rdfs:label "Research Paper" ;
    rdfs:comment "A scholarly article presenting original research" .

ex:Conference rdf:type owl:Class ;
    rdfs:label "Conference" ;
    rdfs:comment "An academic conference" .

ex:ResearchArea rdf:type owl:Class ;
    rdfs:label "Research Area" ;
    rdfs:comment "A field of academic study" .

ex:Grant rdf:type owl:Class ;
    rdfs:label "Research Grant" ;
    rdfs:comment "Funding for research activities" .

ex:Patent rdf:type owl:Class ;
    rdfs:label "Patent" ;
    rdfs:comment "An intellectual property right" .

# Properties
ex:affiliatedWith rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Researcher ;
    rdfs:range ex:University ;
    rdfs:label "affiliated with" .

ex:memberOf rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Researcher ;
    rdfs:range ex:Department ;
    rdfs:label "member of" .

ex:advisedBy rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Researcher ;
    rdfs:range ex:Researcher ;
    rdfs:label "advised by" .

ex:advises rdf:type owl:ObjectProperty ;
    owl:inverseOf ex:advisedBy ;
    rdfs:label "advises" .

ex:coAuthor rdf:type owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain ex:Researcher ;
    rdfs:range ex:Researcher ;
    rdfs:label "co-author" .

ex:researchArea rdf:type owl:ObjectProperty ;
    rdfs:domain ex:Researcher ;
    rdfs:range ex:ResearchArea ;
    rdfs:label "research area" .

ex:hIndex rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:Researcher ;
    rdfs:range xsd:integer ;
    rdfs:label "h-index" .

ex:citationCount rdf:type owl:DatatypeProperty ;
    rdfs:domain ex:ResearchPaper ;
    rdfs:range xsd:integer ;
    rdfs:label "citation count" .

# ==================
# UNIVERSITIES
# ==================

ex:stanford-university rdf:type ex:University ;
    rdfs:label "Stanford University" ;
    foaf:name "Stanford University" ;
    foaf:homepage <https://www.stanford.edu> ;
    ex:founded "1885"^^xsd:gYear ;
    ex:location "Stanford, California, USA" ;
    ex:ranking "3"^^xsd:integer ;
    ex:studentCount "17000"^^xsd:integer ;
    ex:endowment "37800000000"^^xsd:decimal ;  # in USD
    ex:motto "Die Luft der Freiheit weht" .

ex:mit rdf:type ex:University ;
    rdfs:label "Massachusetts Institute of Technology" ;
    foaf:name "MIT" ;
    foaf:homepage <https://www.mit.edu> ;
    ex:founded "1861"^^xsd:gYear ;
    ex:location "Cambridge, Massachusetts, USA" ;
    ex:ranking "1"^^xsd:integer ;
    ex:studentCount "11520"^^xsd:integer ;
    ex:endowment "27400000000"^^xsd:decimal .

ex:berkeley rdf:type ex:University ;
    rdfs:label "University of California, Berkeley" ;
    foaf:name "UC Berkeley" ;
    foaf:homepage <https://www.berkeley.edu> ;
    ex:founded "1868"^^xsd:gYear ;
    ex:location "Berkeley, California, USA" ;
    ex:ranking "4"^^xsd:integer ;
    ex:studentCount "45000"^^xsd:integer .

# ==================
# DEPARTMENTS
# ==================

ex:stanford-cs rdf:type ex:Department ;
    rdfs:label "Stanford Computer Science" ;
    foaf:name "Department of Computer Science" ;
    org:unitOf ex:stanford-university ;
    foaf:homepage <https://cs.stanford.edu> ;
    ex:facultyCount "85"^^xsd:integer ;
    ex:established "1965"^^xsd:gYear .

ex:mit-csail rdf:type ex:Department ;
    rdfs:label "MIT CSAIL" ;
    foaf:name "Computer Science and Artificial Intelligence Laboratory" ;
    org:unitOf ex:mit ;
    foaf:homepage <https://www.csail.mit.edu> ;
    ex:facultyCount "100"^^xsd:integer ;
    ex:established "2003"^^xsd:gYear .

ex:berkeley-eecs rdf:type ex:Department ;
    rdfs:label "Berkeley EECS" ;
    foaf:name "Electrical Engineering and Computer Sciences" ;
    org:unitOf ex:berkeley ;
    foaf:homepage <https://eecs.berkeley.edu> ;
    ex:facultyCount "120"^^xsd:integer ;
    ex:established "1973"^^xsd:gYear .

# ==================
# RESEARCH AREAS
# ==================

ex:machine-learning rdf:type ex:ResearchArea ;
    rdfs:label "Machine Learning" ;
    ex:description "Algorithms that improve through experience" ;
    ex:parentArea ex:artificial-intelligence .

ex:artificial-intelligence rdf:type ex:ResearchArea ;
    rdfs:label "Artificial Intelligence" ;
    ex:description "Intelligence demonstrated by machines" .

ex:natural-language-processing rdf:type ex:ResearchArea ;
    rdfs:label "Natural Language Processing" ;
    ex:description "Interaction between computers and human language" ;
    ex:parentArea ex:artificial-intelligence .

ex:computer-vision rdf:type ex:ResearchArea ;
    rdfs:label "Computer Vision" ;
    ex:description "Automatic extraction of information from images" ;
    ex:parentArea ex:artificial-intelligence .

ex:semantic-web rdf:type ex:ResearchArea ;
    rdfs:label "Semantic Web" ;
    ex:description "Extension of the Web to make data machine-readable" .

ex:databases rdf:type ex:ResearchArea ;
    rdfs:label "Databases" ;
    ex:description "Organized collection of structured information" .

ex:robotics rdf:type ex:ResearchArea ;
    rdfs:label "Robotics" ;
    ex:description "Design, construction, and operation of robots" .

# ==================
# RESEARCHERS
# ==================

