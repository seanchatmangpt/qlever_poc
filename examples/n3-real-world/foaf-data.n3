        rdfs:label "Seattle, WA"
    ] ;

    foaf:knows person:charlie .

# ==================
# GROUPS AND PROJECTS
# ==================

# A research group
ex:semantic-web-research-group rdf:type foaf:Group ;
    foaf:name "Semantic Web Research Group" ;
    foaf:homepage <http://swresearch.example.org> ;
    foaf:member person:alice, person:edward ;
    ex:leader person:edward ;
    ex:founded "2015-01-01"^^xsd:date .

# An open source project
ex:rdf-toolkit-project rdf:type foaf:Project ;
    foaf:name "RDF Toolkit" ;
    foaf:homepage <http://github.com/rdf-toolkit> ;
    ex:maintainer person:alice ;
    ex:contributor person:bob ;
    ex:license "Apache 2.0" ;
    ex:status "Active" .

# A professional organization
ex:data-science-society rdf:type foaf:Organization ;
    foaf:name "Data Science Society" ;
    foaf:homepage <http://datasciencesociety.org> ;
    foaf:member person:bob, person:alice ;
    ex:president person:bob ;
    ex:membershipType "Professional" .

# ==================
# DOCUMENTS AND PUBLICATIONS
# ==================

ex:paper-semantic-web rdf:type foaf:Document ;
    foaf:title "Advances in Semantic Web Technologies" ;
    ex:author person:alice, person:edward ;
    ex:publicationDate "2024-06-15"^^xsd:date ;
    ex:journal "Journal of Web Semantics" ;
    ex:doi "10.1234/jws.2024.001" ;
    foaf:page <http://journal.example.org/papers/semantic-web-2024> .

ex:blog-post-ml rdf:type foaf:Document ;
    foaf:title "Machine Learning Best Practices" ;
    ex:author person:alice ;
    ex:publicationDate "2024-11-20"^^xsd:date ;
    foaf:page <http://alice-johnson.com/blog/ml-best-practices> ;
    ex:format "Blog Post" .

ex:design-portfolio rdf:type foaf:Document ;
    foaf:title "Charlie's Design Portfolio 2024" ;
    ex:author person:charlie ;
    foaf:page <http://charlie-designs.com/portfolio> ;
    ex:format "Portfolio" .

# ==================
# IMAGES AND MEDIA
# ==================

ex:alice-photo rdf:type foaf:Image ;
    rdfs:label "Alice's Profile Photo" ;
    foaf:depicts person:alice ;
    foaf:maker person:alice ;
    ex:width "800"^^xsd:integer ;
    ex:height "800"^^xsd:integer ;
    ex:format "image/jpeg" .

ex:charlie-artwork rdf:type foaf:Image ;
    rdfs:label "Charlie's Abstract Art" ;
    foaf:maker person:charlie ;
    ex:width "1920"^^xsd:integer ;
    ex:height "1080"^^xsd:integer ;
    ex:format "image/png" ;
    ex:license "CC BY-SA 4.0" .

# ==================
# INVERSE RELATIONSHIPS
# ==================

# Mutual knows relationships (already defined above, shown here for clarity)
# Alice knows Bob, Charlie, Diana
# Bob knows Alice, Charlie
# Charlie knows Alice, Bob, Diana
# Diana knows Alice, Charlie
# Edward knows Alice
# Fiona knows Charlie

# Triple count: Approximately 300+ triples
# This demonstrates real-world FOAF usage for social network representation
