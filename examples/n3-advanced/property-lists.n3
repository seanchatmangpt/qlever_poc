        ex:oneStarCount "0"^^xsd:integer
    ] .

# ==================
# PROPERTY LIST BEST PRACTICES
# ==================

# Example 15: Readable formatting with proper indentation
ex:well-formatted-entity rdf:type ex:Example ;
    # Group related properties together
    # Basic information
    ex:name "Example Entity" ;
    ex:type "Demonstration" ;
    ex:created "2024-01-01"^^xsd:date ;

    # Use comments to explain complex sections
    # Contact information
    ex:email "contact@example.org" ;
    ex:phone "+1-555-0100" ;
    ex:website <http://example.org> ;

    # Use blank nodes for structured sub-properties
    ex:location [
        ex:city "San Francisco" ;
        ex:country "USA"
    ] ;

    # Use commas for multiple values of same property
    ex:tags "example", "demonstration", "best-practices" ;

    # End with a period
    ex:status "Active" .

# Triple count: Approximately 500+ triples
# This demonstrates various property list patterns and best practices for readable N3
