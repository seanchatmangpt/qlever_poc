@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.org/> .

ex:PersonShape
    a sh:NodeShape ;
    sh:targetClass ex:Person ;
    sh:property [
        sh:path ex:phone ;
        sh:minCount 2 ;
        sh:maxCount 3 ;
        sh:message "Person must have 2-3 phone numbers" ;
    ] .
