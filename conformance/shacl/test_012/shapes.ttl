@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.org/> .

ex:PersonShape
    a sh:NodeShape ;
    sh:targetClass ex:Person ;
    sh:property [
        sh:path ex:address ;
        sh:node ex:AddressShape ;
        sh:message "Person must have a valid address" ;
    ] .

ex:AddressShape
    a sh:NodeShape ;
    sh:property [
        sh:path ex:street ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path ex:city ;
        sh:minCount 1 ;
        sh:message "Address must have a city" ;
    ] ;
    sh:property [
        sh:path ex:zipcode ;
        sh:minCount 1 ;
    ] .
