@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.org/> .

ex:PersonShape
    a sh:NodeShape ;
    sh:targetClass ex:Person ;
    sh:property [
        sh:path ex:status ;
        sh:in ( "active" "inactive" "suspended" ) ;
        sh:message "Status must be one of: active, inactive, suspended" ;
    ] .
