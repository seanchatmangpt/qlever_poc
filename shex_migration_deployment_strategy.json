    "phase_2_advanced": {
      "name": "Advanced Constraints and W3C Compliance",
      "status": "PLANNED",
      "priority": "HIGH",
      "estimated_timeline": {
        "duration": "3-4 weeks",
        "sprint_breakdown": {
          "sprint_1": "Numeric range and pattern constraints (week 1)",
          "sprint_2": "Language tags and length constraints (week 2)",
          "sprint_3": "Datatype facets and XSD types (week 3)",
          "sprint_4": "Testing, documentation, and integration (week 4)"
        }
      },
      "features": [
        {
          "name": "Numeric Range Constraints",
          "description": "minInclusive, maxInclusive, minExclusive, maxExclusive for xsd:integer, xsd:decimal, xsd:double",
          "design_ref": "shex_advanced_constraints_design.json lines 2-51",
          "implementation_complexity": "MEDIUM",
          "estimated_effort": "3-4 days",
          "dependencies": ["util/Exception.h", "C++ standard library math functions"]
        },
        {
          "name": "Pattern Constraints (Regex)",
          "description": "Regular expression validation using RE2 library",
          "design_ref": "shex_advanced_constraints_design.json lines 53-82",
          "implementation_complexity": "LOW",
          "estimated_effort": "2-3 days",
          "dependencies": ["re2::re2 (already available)", "Cached regex compilation for performance"]
        },
        {
          "name": "Language Tag Constraints",
          "description": "BCP47 language tag validation for RDF literals",
          "design_ref": "shex_advanced_constraints_design.json lines 83-122",
          "implementation_complexity": "MEDIUM",
          "estimated_effort": "3-4 days",
          "dependencies": ["rdfTypes/Literal.h", "Existing Literal language tag methods"]
        },
        {
          "name": "Length Constraints",
          "description": "minLength, maxLength, exactLength with UTF-8 awareness",
          "design_ref": "shex_advanced_constraints_design.json lines 123-157",
          "implementation_complexity": "LOW",
          "estimated_effort": "2 days",
          "dependencies": ["parser/NormalizedString.h", "UTF-8 character counting utilities"]
        },
        {
          "name": "Datatype Facets",
          "description": "XSD datatype-specific validation (xsd:integer, xsd:decimal, xsd:string, xsd:date, xsd:dateTime, xsd:boolean)",
          "design_ref": "shex_advanced_constraints_design.json lines 158-207",
          "implementation_complexity": "HIGH",
          "estimated_effort": "5-6 days",
          "dependencies": ["util/Date.h", "util/DateYearDuration.h", "XSD datatype parsing utilities"]
        },
        {
          "name": "Negation and Shape References",
          "description": "NOT operator and recursive shape references",
          "implementation_complexity": "HIGH",
          "estimated_effort": "4-5 days",
          "dependencies": ["Circular reference detection", "Validation cycle breaking"]
        },
        {
          "name": "Closed Shapes with EXTRA",
          "description": "Closed shapes that allow only specified properties plus EXTRA declarations",
          "implementation_complexity": "MEDIUM",
          "estimated_effort": "3-4 days",
          "dependencies": ["PropertyShape tracking", "Extra property detection"]
        }
      ],
      "deliverables": {
        "source_modifications": [
          "src/parser/ShEx.h - Add NumericRangeConstraint, PatternConstraint, LanguageTagConstraint, LengthConstraint, DatatypeFacetConstraint classes",
          "src/parser/ShEx.h - Extend ValueSetConstraint with optional members for new constraints",
