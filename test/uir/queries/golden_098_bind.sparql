# UIR Semantic Equivalence Test
# Query ID: golden_098_bind
# Description: Bind - test 3
# Category: golden
# EPIC: 10.3 - Agent 3 Part 4

PREFIX ex: <http://example.org/>

SELECT ?person ?fullName
WHERE {
  ?person ex:firstName ?first ;
          ex:lastName ?last .
  BIND(CONCAT(?first, " ", ?last) AS ?fullName)
}
LIMIT 10
