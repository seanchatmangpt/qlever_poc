# UIR Semantic Equivalence Test
# Query ID: hybrid_047_hybrid_aggregate_rule
# Description: Hybrid Aggregate Rule - test 2
# Category: hybrid
# EPIC: 10.3 - Agent 3 Part 4

PREFIX ex: <http://example.org/>

# Hybrid: SPARQL aggregate + Datalog rule
# Rule: avgSalary(?dept, ?avg) :- employeeCount(?dept, ?cnt), totalSalary(?dept, ?total), ?avg = ?total / ?cnt.

SELECT ?department (AVG(?salary) AS ?avgSalary)
WHERE {
  ?employee ex:worksIn ?department ;
            ex:hasSalary ?salary .
}
GROUP BY ?department
ORDER BY DESC(?avgSalary)
LIMIT 20
