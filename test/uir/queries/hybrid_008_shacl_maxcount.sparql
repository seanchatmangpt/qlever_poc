# UIR Semantic Equivalence Test
# Query ID: hybrid_008_shacl_maxcount
# Description: Shacl Maxcount - test 3
# Category: hybrid
# EPIC: 10.3 - Agent 3 Part 4

PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX ex: <http://example.org/>

SELECT ?shape ?targetNode ?property ?maxCount
WHERE {
  ?shape a sh:NodeShape ;
         sh:targetClass ex:Person ;
         sh:property ?propertyShape .
  
  ?propertyShape sh:path ?property ;
                 sh:maxCount ?maxCount .
  
  ?targetNode a ex:Person .
}
ORDER BY ?shape ?targetNode
LIMIT 20
