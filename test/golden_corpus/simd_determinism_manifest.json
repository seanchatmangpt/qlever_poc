  "determinism_validation_protocol": {
    "description": "How to validate SIMD vs Scalar equivalence",
    "steps": [
      "1. Parse RDF data through SIMD ingress path → result_simd",
      "2. Parse identical RDF data through scalar fallback path → result_scalar",
      "3. Serialize both results to canonical format (ResultDigest::serializeCanonical)",
      "4. Compute BLAKE3(canonical_simd) and BLAKE3(canonical_scalar)",
      "5. Assert: BLAKE3(canonical_simd) == BLAKE3(canonical_scalar)",
      "6. Record result in manifest.json",
      "7. Repeat for all queries in golden set"
    ],
    "failure_criteria": [
      "Different BLAKE3 digests for same input",
      "Different row counts",
      "Different column counts",
      "Different row ordering (unless ORDER BY is absent - then unordered set comparison)",
      "Forbidden content detected (pointers, thread IDs, timestamps, floats in digest)"
    ],
    "success_criteria": "All queries produce identical BLAKE3 digests for SIMD and Scalar paths"
  },

