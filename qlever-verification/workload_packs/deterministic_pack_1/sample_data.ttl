@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex: <http://example.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Deterministic RDF dataset for workload pack testing
# This data is intentionally small and reproducible

ex:Person1 rdf:type ex:Person ;
    ex:name "Alice" ;
    ex:age "30"^^xsd:integer ;
    ex:city ex:NewYork .

ex:Person2 rdf:type ex:Person ;
    ex:name "Bob" ;
    ex:age "25"^^xsd:integer ;
    ex:city ex:Boston .

ex:Person3 rdf:type ex:Person ;
    ex:name "Charlie" ;
    ex:age "35"^^xsd:integer ;
    ex:city ex:NewYork .

ex:NewYork rdf:type ex:City ;
    ex:cityName "New York" ;
    ex:population "8000000"^^xsd:integer .

ex:Boston rdf:type ex:City ;
    ex:cityName "Boston" ;
    ex:population "700000"^^xsd:integer .

ex:Person1 ex:knows ex:Person2 .
ex:Person2 ex:knows ex:Person3 .
ex:Person3 ex:knows ex:Person1 .
