4.2 Changes to JsonLdIngressNormalizer.cpp
-------------------------------------------

CHANGE 1: Added include for DivergenceAbort
  Location: Line 15
  Before:  #include "IngressDigest.h"
  After:   #include "DivergenceAbort.h"
           #include "IngressDigest.h"

CHANGE 2: Guard breach → immediate abort
  Location: Lines 126-132 (originally 126-129)
  Before:  if (json_ld_input.size() > guards.max_input_size_bytes) {
             result.error = IngressErrorCode::BUFFER_OVERFLOW;
             return result;
           }
  After:   if (json_ld_input.size() > guards.max_input_size_bytes) {
             DIVERGENCE_ABORT_GUARD_BREACH(
                 "Input size exceeds guard limit - potential resource exhaustion");
           }

  Behavior change: ABORT instead of returning error code

CHANGE 3: Canonicalization failure → immediate abort
  Location: Lines 325-338 (originally 324-329)
  Before:  try {
             canonical_output.clear();
             canonicalize(doc, canonical_output);
           } catch (...) {
             return IngressErrorCode::NORMALIZATION_FAILED;
           }
  After:   try {
             canonical_output.clear();
             canonicalize(doc, canonical_output);
           } catch (const std::exception& e) {
             DIVERGENCE_ABORT(AbortCategory::CORRUPT_INDEX_DATA,
                 "Canonicalization failed - corrupt JSON structure detected");
           } catch (...) {
             DIVERGENCE_ABORT(AbortCategory::INTERNAL_ERROR,
                 "Unknown exception during JSON canonicalization");
           }

  Behavior change: ABORT instead of returning error code

