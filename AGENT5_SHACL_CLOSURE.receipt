Data Graph (Valid):
  ex:Alice a ex:Person ;
    ex:name "Alice" .

Data Graph (Invalid):
  ex:Bob a ex:Person .
  # Missing required ex:name property

Test Execution:
  PropertyShape propWithMinCount("ex:name");
  propWithMinCount.constraints.push_back(minCount1);

  auto resultValid = ShaclConstraintEvaluator::evaluatePropertyShape(
    "ex:Alice", propWithMinCount, {"Alice"}
  );
  EXPECT_TRUE(resultValid.conforms);  // PASS

  auto resultInvalid = ShaclConstraintEvaluator::evaluatePropertyShape(
    "ex:Bob", propWithMinCount, {}
  );
  EXPECT_FALSE(resultInvalid.conforms);  // PASS (correctly detects violation)

