{
  "name": "qlever-wasm",
  "version": "0.1.0",
  "description": "QLever WebAssembly bindings for JavaScript/Node.js - High-performance SPARQL query client",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ad-freiburg/qlever"
  },
  "main": "pkg/qlever_wasm.js",
  "types": "pkg/qlever_wasm.d.ts",
  "files": [
    "pkg/",
    "dist/",
    "src/index.d.ts",
    "README.md",
    "README_NPM.md"
  ],
  "exports": {
    ".": {
      "require": "./pkg/qlever_wasm.js",
      "import": "./pkg/qlever_wasm.js",
      "types": "./pkg/qlever_wasm.d.ts"
    },
    "./browser": {
      "browser": "./dist/browser.js",
      "import": "./dist/browser.js",
      "types": "./src/browser.ts"
    },
    "./node": {
      "node": "./dist/node.js",
      "import": "./dist/node.js",
      "require": "./dist/node.js",
      "types": "./src/node.ts"
    }
  },
  "scripts": {
    "build": "wasm-pack build --release",
    "build:dev": "wasm-pack build",
    "build:libqlever": "bash build_with_emscripten.sh",
    "build:libqlever:dev": "bash build_with_emscripten.sh --dev",
    "build:browser": "npm run build && npm run build:types && tsc src/browser.ts --outDir dist --target es2020 --module esnext --declaration",
    "build:node": "npm run build && npm run build:types && tsc src/node.ts --outDir dist --target es2020 --module esnext --declaration",
    "build:all": "npm run build:browser && npm run build:node",
    "build:types": "tsc src/index.d.ts --noEmit",
    "dev": "wasm-pack build --dev",
    "test": "vitest run",
    "test:build": "vitest run tests/build.test.ts",
    "test:load": "vitest run tests/load.test.ts",
    "test:datafactory": "vitest run tests/datafactory.test.ts",
    "test:querybuilder": "vitest run tests/querybuilder.test.ts",
    "test:store": "vitest run tests/store.test.ts",
    "test:examples": "vitest run tests/examples.test.ts",
    "test:performance": "vitest run tests/performance.test.ts",
    "test:browser": "vitest run --environment jsdom tests/browser.test.ts",
    "test:node": "vitest run --environment node tests/node.test.ts",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=verbose",
    "test:debug": "vitest --inspect-brk --inspect --single-thread",
    "test:profile": "node --prof tests/perf-profile.js",
    "test:libqlever": "npm run build:libqlever && npm run test",
    "clean": "rm -rf pkg dist target wasm_build coverage",
    "prepublishOnly": "npm run build:all && npm run test:coverage"
  },
  "keywords": [
    "qlever",
    "wasm",
    "sparql",
    "rdf",
    "graph-database",
    "query",
    "websocket"
  ],
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "jsdom": "^23.0.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
